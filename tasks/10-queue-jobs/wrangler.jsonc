  "queues": { "producers": [{ "binding": "JOBS", "queue": "jobs" }],
              "consumers": [{ "queue": "jobs", "max_batch_size": 10, "max_batch_timeout": 1 }] },
  "kv_namespaces": [{ "binding": "RESULTS", "id": "results" }] }
