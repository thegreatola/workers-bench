{
  "name": "workers-bench",
  "version": "1.0.0",
  "description": "How well AI coding agents write Cloudflare Workers, graded in workerd",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --config vitest.unit.config.ts",
    "bench": "tsx src/bench.ts",
    "report": "tsx src/report.ts",
    "check-tasks": "tsx src/check-tasks.ts",
    "typecheck": "tsc --noEmit",
    "regrade": "tsx src/regrade.ts"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "benchmark",
    "ai-agents",
    "evals"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261124.2",
    "@types/node": "^26.6.7",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261123.1": true
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thegreatola/workers-bench.git"
  }
}
